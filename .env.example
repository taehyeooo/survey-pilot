# 복사해서 .env.local로 쓴다(.env.local은 커밋하지 않는다). 무엇인지는 docs/specs/2026-10-29-survey-pilot.md "환경변수".
# NEXT_PUBLIC_으로 시작하지 않는 값은 모두 비밀값 — 클라이언트 번들에 들어가면 npm run check:bundle이 실패한다.

# Supabase — knowledge-base/concepts/supabase-api-keys.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini 무료 티어와 한도(ADR 0018)
GEMINI_API_KEY=
GEMINI_RPM=5
GEMINI_RPD=20

# 인증번호 메일(Gmail SMTP 앱 비밀번호)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_DAILY_LIMIT=100

# 관리자·연락처
ADMIN_EMAIL=
CONTACT_EMAIL=

# 서버 비밀값 — 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HASH_SECRET=
CRON_SECRET=
